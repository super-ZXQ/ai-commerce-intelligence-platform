# AI Commerce Intelligence Platform - Docker Compose 环境变量
# 复制此文件为 .env 并修改配置

# MySQL
DB_ROOT_PASSWORD=replace-with-root-password
DB_APP_PASSWORD=replace-with-readonly-api-password
DB_AI_PASSWORD=replace-with-readonly-ai-password
DB_SYNC_PASSWORD=replace-with-data-sync-password
DB_EVENT_PASSWORD=replace-with-event-writer-password
# 认证/审计表专用账号 ea_auth；不能读取 orders 等业务数据
DB_AUTH_PASSWORD=replace-with-auth-password
# Alembic schema migration（DDL）账号 ea_migrate；勿复用 ea_ai 只读账号
DB_MIGRATE_PASSWORD=replace-with-migration-ddl-password
DB_NAME=ai_commerce_intelligence_platform

# Redis
REDIS_PASSWORD=
# 会话使用独立逻辑 DB（仅命名隔离，不解决淘汰隔离）；必须与 REDIS_DB 不同
REDIS_DB=0
REDIS_SESSION_DB=1

# Nginx 统一入口
NGINX_PORT=80

# FastAPI 后端
# 生产必须填写：openssl rand -hex 32 生成；留空或使用示例值会启动失败。
JWT_SECRET=
ADMIN_USERNAME=admin
# 生产只接受 bcrypt 哈希：python -m backend.utils.auth '明文密码'
# 哈希含 $，在 Compose .env 里必须用单引号包裹，例如：
#   ADMIN_PASSWORD='$2b$12$....'
# 留空会启动失败；首次启动仅在 auth_users 为空时用它创建管理员。
ADMIN_PASSWORD=
ANALYST_USERNAME=analyst
# 同上，可留空表示不创建分析员账号。
ANALYST_PASSWORD=
DEBUG=false
# 统一会话 Cookie：生产启用 HTTPS 后必须设为 true；samesite=none 时强制 secure
AUTH_COOKIE_NAME=ea_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Streamlit 页面跳转地址；Docker 部署默认走 Nginx 同源路径
LOGIN_URL=/login
LOGOUT_URL=/logout
# Docker 部署必须开启：Nginx 反代后所有请求的 client.host 都是容器网关 IP，
# 不开启的话全体用户共享同一个限流桶，一个高频用户就能让全站触发 429。
# 仅当后端直接对公网暴露（无可信反代）时才设为 false，否则 XFF 可被伪造绕过限流。
TRUST_PROXY_HEADERS=true

# AI 分析助手
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# managed：只用服务端平台密钥；byok：允许用户自带密钥（需 ALLOW_BYOK=true）
LLM_MODE=managed
ALLOW_BYOK=false
# 托管与 BYOK 共用的出站主机白名单（精确匹配，逗号分隔）
LLM_PROVIDER_ALLOWLIST=api.deepseek.com
# 资源与成本限制：并发、单用户排队、每日额度与查询超时
AI_MAX_CONCURRENCY=2
AI_MAX_INFLIGHT_PER_USER=1
AI_DAILY_REQUEST_LIMIT=200
AI_QUEUE_TIMEOUT_SECONDS=10
AI_QUERY_TIMEOUT_SECONDS=120
# 订单导入审计中的操作人（可选）
IMPORT_OPERATOR=operator
