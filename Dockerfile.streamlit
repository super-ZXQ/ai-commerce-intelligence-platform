FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/app

WORKDIR /app

COPY requirements.streamlit.txt .
RUN python -m pip install --no-cache-dir --upgrade "pip>=26.1.2" "setuptools>=84.2.1" \
    && pip install --no-cache-dir -r requirements.streamlit.txt

# 只复制 BI 页面实际需要的文件：COPY . . 会把 data/cleaned_orders.csv（16MB+）
# 与后端、Agent、Notebook 全部带进镜像，而 BI 只通过 HTTP API 取数。
COPY streamlit_app.py ./
COPY bi_api.py bi_rfm.py bi_style.py ./
COPY backend/__init__.py ./backend/
COPY backend/utils/__init__.py ./backend/utils/
COPY backend/utils/rfm_scoring.py ./backend/utils/

RUN mkdir -p /home/app \
    && chown 10001:10001 /home/app

# Streamlit 只读取代码并向 backend 发起 HTTP 请求，不持有数据库凭据。
USER 10001:10001

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "from urllib.request import urlopen; urlopen('http://localhost:8501/BI/_stcore/health', timeout=5)" || exit 1

CMD ["streamlit", "run", "streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true", "--browser.gatherUsageStats=false", "--server.fileWatcherType=none"]
